    {
      "id": 9,
      "title": "Logs d’erreurs — Loki / Fluent Bit",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Attendra Loki et Fluent Bit (etape 6 du TP3). Affiche les messages contenant ERROR du namespace choisi.",
      "transparent": true,
      "pluginVersion": "13.3.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "{namespace=\"$namespace\"} |= \"ERROR\"",
          "queryType": "range",
          "editorMode": "code",
          "direction": "backward",
          "maxLines": 500
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
